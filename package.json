{
  "name": "node-observe",
  "version": "0.1.0",
  "description": "Lightweight backend observability for Node.js — API latency, MongoDB & Redis query timing, memory-leak detection, and Slack alerts. Datadog-lite for small teams, with no agent and minimal dependencies.",
  "keywords": [
    "observability",
    "monitoring",
    "apm",
    "metrics",
    "latency",
    "performance",
    "express",
    "mongoose",
    "mongodb",
    "redis",
    "ioredis",
    "memory-leak",
    "slack",
    "alerts",
    "percentiles"
  ],
  "license": "MIT",
  "author": "sriramadari",
  "homepage": "https://github.com/sriramadari/node-observe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriramadari/node-observe.git"
  },
  "bugs": {
    "url": "https://github.com/sriramadari/node-observe/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
